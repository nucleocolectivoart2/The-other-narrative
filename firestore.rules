rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- CONTENIDO EDITORIAL Y PORTAFOLIO ---
    match /contentItems/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /podcasts/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /resources/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /recognitions/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /featuredVideos/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if true;
    }

    // --- ROLES ADMINISTRATIVOS ---
    match /adminRoles/{userId} {
      allow read, write: if true;
    }

    // --- MENSAJES DE CONTACTO ---
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
                       request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.message is string;
      allow read, update, delete: if true;
    }

    // Regla de cierre de seguridad
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA DE AUTORIZACIÓN ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Autorización por correo verificado de los miembros del equipo editorial
    function isAuthorizedEmail() {
      return isSignedIn() && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'angelamgomez@gmail.com' || 
          request.auth.token.email.lower() == 'nucleo.colectivo.art@gmail.com' ||
          request.auth.token.email.lower() == 'nucleo.colectivo.art2@gmail.com'
        );
    }

    // Verifica rol de administrador en Firestore o por correo autorizado
    function isAdmin() {
      return isAuthorizedEmail() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // --- ROLES ADMINISTRATIVOS ---
    match /adminRoles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAuthorizedEmail(); 
    }

    // --- CONTENIDO EDITORIAL Y PORTAFOLIO ---
    match /contentItems/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /podcasts/{id} {
      allow read, write: if true;
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /resources/{id} {
      allow read: if true;
      allow create, delete: if isSignedIn();
      // Permite tanto al equipo como a los visitantes públicos actualizar el contador de descargas
      allow update: if true;
    }

    match /recognitions/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /featuredVideos/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /siteSettings/{id} {
      allow read, write: if true;
    }

    // --- MENSAJES DE CONTACTO ---
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Regla de cierre de seguridad
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
